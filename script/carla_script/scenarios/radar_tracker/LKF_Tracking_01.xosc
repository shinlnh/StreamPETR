    <Story name="LaneChangeStory">
      <Act name="LaneChangeBehavior">
        <!-- Adversary lane 1 -->
        <ManeuverGroup maximumExecutionCount="2" name="LaneChangeAdversaryLane1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="adversary_lane_1"/>
          </Actors>
          <Maneuver name="TurnSequence">
            <!-- Drive Forward 20m -->
            <Event name="DriveForward_1" priority="overwrite">
              <Action name="DriveForwardAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="step" value="20" dynamicsDimension="distance"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$targetSpeed_adversary_lane_1"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="StartDriving" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="adversary_lane_1"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <TraveledDistanceCondition value="0.0"/>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            
            <!-- Change Right Lane -->
