diff --git a/mmcv/parallel/data_container.py b/mmcv/parallel/data_container.py
index 62f2573..62da9c9 100644
--- a/mmcv/parallel/data_container.py
+++ b/mmcv/parallel/data_container.py
@@ -8,0 +9,12 @@ import torch
+def _pin_memory(data):
+    if isinstance(data, torch.Tensor):
+        return data.pin_memory()
+    if isinstance(data, dict):
+        return {key: _pin_memory(value) for key, value in data.items()}
+    if isinstance(data, tuple):
+        return tuple(_pin_memory(value) for value in data)
+    if isinstance(data, list):
+        return [_pin_memory(value) for value in data]
+    return data
+
+
@@ -91,0 +104,6 @@ class DataContainer:
+
+    def pin_memory(self):
+        """Pin tensor payloads so MMCV can copy them to CUDA asynchronously."""
+        if not self.cpu_only:
+            self._data = _pin_memory(self._data)
+        return self
